<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CustomDieApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CustomDieApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CustomDieApp">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
<StackPanel>
<Grid Margin="5"  HorizontalAlignment="Center"
              ColumnDefinitions="Auto, Auto"
              RowDefinitions="Auto, Auto">
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="10">Die size: </TextBlock>
    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0 5" Text="{Binding dieSize}"/>
    <TextBlock Grid.Row="1" Grid.Column="0" Margin="10">Die sides: </TextBlock>
    <TextBlock Grid.Row="1" Grid.Column="1" Width="100" Margin="0 5" Text="{Binding SidesText}"/>
    </Grid>
    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding NoDuplicates}" Content="No duplicate rolls" />
    <NumericUpDown HorizontalAlignment="Center" Width="150" Value="{Binding HowManyRolls}" Minimum="1" FormatString="0" />
    <Button HorizontalAlignment="Center" Command="{Binding RollADieCommand}">Roll the die</Button>
    <TextBlock Text="{Binding RollResults}" HorizontalAlignment="Center"/>
    <Button HorizontalAlignment="Center">Make a new die (TODO)</Button>
</StackPanel>

</Window>
